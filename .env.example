# Copy to .env and fill in. Never commit .env. Step-by-step: docs/blockers.md

# General
TZ=Europe/Berlin
WEBHOOK_URL=http://localhost:5678/   # n8n's own address: keep localhost, so the form page can follow its run (the tunnel only forwards Slack clicks)
# Fixed tunnel (free ngrok static domain), started by docker compose; the URL never changes
COMPOSE_PROFILES=tunnel
NGROK_AUTHTOKEN=                 # ngrok dashboard → Your Authtoken (secret)
NGROK_DOMAIN=                    # ngrok dashboard → Domains → your free static domain, without https://
N8N_API_KEY=
N8N_INTERNAL_URL=http://localhost:5678            # how workflows call each other's webhooks inside the container

# Test mode (keep on for the whole demo)
DEMO_MODE=true                    # every email → TEST_PROSPECT_EMAIL, subject starts with [TEST], days become minutes
TEST_LEAD_LIMIT=10                # default "Max leads" when the form field is empty (test mode); the form number decides
TEST_RECIPIENT_ALLOWLIST=         # comma-separated test inboxes; empty = every send is blocked
AUTO_REPLY_MIN_CONFIDENCE=0.85    # interested replies at/above this are answered automatically
ALLOW_REAL_SENDING=false          # real sending needs DEMO_MODE=false AND this true
MOCK_EXTERNAL=false               # true = all external APIs go to tests/mock_server (tests only)

# Airtable (start the 14-day Team trial)
AIRTABLE_PAT=
AIRTABLE_BASE_ID=
AIRTABLE_INTERFACE_URL=           # optional; empty = the "Open full list" button opens the campaign status page

# Google Places API (New) – key restricted to Places API (New), €5 budget alert, 200 requests/day quota
GOOGLE_MAPS_API_KEY=

# Scraping (optional, Indeed hiring signal – not built, see docs/decisions.md)
APIFY_TOKEN=

# AI: set AI_PROVIDER to openai or anthropic
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Email (demo: two Gmail accounts; the Gmail OAuth credential is connected in the n8n UI)
SENDER_EMAIL=
TEST_PROSPECT_EMAIL=
GMAIL_CREDENTIAL_ID=              # id of the 'Gmail sender' credential in n8n (from its URL); the deploy script attaches it

# Slack
SLACK_WEBHOOK_URL=                # incoming webhook, used by the error handler
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL=#leads

# Booking
CALENDLY_LINK=
CALENDLY_TOKEN=
CALENDLY_WEBHOOK_SIGNING_KEY=     # only with a paid Calendly plan (webhooks); the free plan uses polling (07d)

# CRM
HUBSPOT_TOKEN=
