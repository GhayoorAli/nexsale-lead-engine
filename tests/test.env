# Test-stack environment (no real secrets). Used by docker-compose.test.yml.
TZ=Europe/Berlin
DEMO_MODE=true
MOCK_EXTERNAL=true
MOCK_BASE_URL=http://host.docker.internal:8787
TEST_LEAD_LIMIT=10
TEST_RECIPIENT_ALLOWLIST=sender.test@nexsale-demo.test,prospect.test@nexsale-demo.test
TEST_PROSPECT_EMAIL=prospect.test@nexsale-demo.test
SENDER_EMAIL=sender.test@nexsale-demo.test
AUTO_REPLY_MIN_CONFIDENCE=0.85
WEBHOOK_URL=http://localhost:5679/
AIRTABLE_PAT=mock
AIRTABLE_BASE_ID=appMOCKBASE000001
GOOGLE_MAPS_API_KEY=mock
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=mock
SLACK_WEBHOOK_URL=http://host.docker.internal:8787/slack/webhook
SLACK_BOT_TOKEN=mock
SLACK_SIGNING_SECRET=test_signing_secret_not_real
SLACK_CHANNEL=#leads
CALENDLY_LINK=https://calendly.com/nexsale-demo/15min
HUBSPOT_TOKEN=mock
AIRTABLE_INTERFACE_URL=https://airtable.com/appMOCKBASE000001
DISABLE_DEMO_TICKER=true
DISABLE_SCHEDULES=true
